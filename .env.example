# Choose one LLM provider. See market_research/llm.py for exactly what each
# value needs.
LLM_PROVIDER=openai

# --- LLM_PROVIDER=openai (CrewAI's default) ---
OPENAI_API_KEY=your_openai_api_key
# Optional, defaults to openai/gpt-4o-mini:
# OPENAI_MODEL_NAME=openai/gpt-4o-mini

# --- LLM_PROVIDER=do_serverless (DigitalOcean serverless inference) ---
# DO_MODEL_ACCESS_KEY=your_do_model_access_key
# DO_MODEL_ID=your_do_model_id
# List available model ids with:
#   curl -s -H "Authorization: Bearer $DO_MODEL_ACCESS_KEY" https://inference.do-ai.run/v1/models

# Where "my product" facts come from. local_markdown (default) reads
# product_narsi.md offline with no model call. do_knowledge_base is
# EXPERIMENTAL and does NOT call a real hosted DigitalOcean knowledge base:
# it prompts a generic LLM with nothing actually attached, so its "facts"
# and citations are not grounded in any real document -- see
# market_research/facts.py's DOKnowledgeBaseSource docstring before using it.
FACTS_SOURCE=local_markdown

# Real web search for competitor pages. Optional: without this, the pipeline
# falls back to an empty FixtureSearch and fetches zero competitor pages.
# SERPER_API_KEY=your_serper_api_key
